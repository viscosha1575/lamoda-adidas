    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/session - Telegram",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "if (payload?.data?.token) {",
                  "  pm.collectionVariables.set('auth_token', payload.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Telegram-Init-Data",
                "value": "{{init_data}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referralCode\": \"{{referral_code}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/session",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "session"
              ]
            },
            "description": "Создаёт сессию по Telegram initData. `initData` передаётся только в заголовке `X-Telegram-Init-Data`. После выполнения автоматически сохраняет `auth_token` в переменные коллекции."
          },
          "response": []
        },
        {
          "name": "DELETE /api/auth/current",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
