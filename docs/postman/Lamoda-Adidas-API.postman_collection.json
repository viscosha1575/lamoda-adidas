{
  "info": {
    "_postman_id": "70eb532a-6171-493d-a411-a3e02c0f4a91",
    "name": "Lamoda Adidas API",
    "description": "Актуальная Postman-коллекция для Lamoda Adidas. Игровой поток теперь строится вокруг POST /api/game/start-session: этот endpoint и создает новую сессию, и резюмит уже существующую active-сессию. POST /api/game/finish для неполной сессии не закрывает ее, а принудительно ставит remainingSeconds=0 и completionReason=time-ended.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://lamoda-specials.ru"
    },
    {
      "key": "init_data",
      "value": "query_id=AAExample&user=%7B%22id%22%3A123456789%2C%22first_name%22%3A%22Mila%22%2C%22last_name%22%3A%22Test%22%2C%22username%22%3A%22lamoda_player%22%7D&auth_date=1710000000"
    },
    {
      "key": "referral_code",
      "value": "https://t.me/lamoda_games_bot/search?startapp=PLAYER42"
    },
    {
      "key": "sneaker_number",
      "value": "2"
    }
  ],
  "item": [
    {
      "name": "Root",
      "item": [
        {
          "name": "GET /",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                ""
              ]
            },
            "description": "Проверка, что сервис отвечает."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Healthcheck API и базы."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "const player = payload?.data?.player;",
                  "if (player?.id) { pm.collectionVariables.set('player_id', String(player.id)); }",
                  "if (player?.referralCode) { pm.collectionVariables.set('player_referral_code', player.referralCode); }",
                  "if (player?.raffleWon !== undefined) { pm.collectionVariables.set('raffle_won', String(player.raffleWon)); }",
                  "if (payload?.data?.session?.id) { pm.collectionVariables.set('game_session_id', String(payload.data.session.id)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Telegram-Init-Data",
                "value": "{{init_data}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referralCode\": \"{{referral_code}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/session",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "session"
              ]
            },
            "description": "Создает/обновляет auth-сессию игрока и возвращает snapshot текущего game state. `initData` передается только в заголовке `X-Telegram-Init-Data`."
          },
          "response": []
        },
        {
          "name": "DELETE /api/auth/current",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Telegram-Init-Data",
                "value": "{{init_data}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/current",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "current"
              ]
            },
            "description": "Удаляет текущего игрока."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Game",
      "item": [
        {
          "name": "POST /api/game/start-session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "if (payload?.data?.session?.id) { pm.collectionVariables.set('game_session_id', String(payload.data.session.id)); }",
                  "if (payload?.data?.reason !== undefined) { pm.collectionVariables.set('game_reason', String(payload.data.reason)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Telegram-Init-Data",
                "value": "{{init_data}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/api/game/start-session",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "game",
                "start-session"
              ]
            },
            "description": "Основная точка входа в игру. Если active-сессии нет, создает новую. Если active-сессия уже есть, резюмит ее и пересчитывает timer на стороне сервера."
          },
          "response": []
        },
        {
          "name": "GET /api/game/subscription-status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Telegram-Init-Data",
                "value": "{{init_data}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/game/subscription-status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "game",
                "subscription-status"
              ]
            },
            "description": "Проверка Telegram-подписки игрока."
          },
          "response": []
        },
        {
          "name": "POST /api/game/activity-log",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Telegram-Init-Data",
                "value": "{{init_data}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source\": \"webapp\",\n  \"action\": \"presence-ping\",\n  \"details\": {\n    \"visibilityState\": \"visible\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/game/activity-log",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "game",
                "activity-log"
              ]
            },
            "description": "Логирует игровое действие / пинг активности."
          },
          "response": []
        },
        {
          "name": "POST /api/game/found-sneaker",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "if (payload?.data?.reason !== undefined) { pm.collectionVariables.set('game_reason', String(payload.data.reason)); }",
                  "if (payload?.data?.session?.id) { pm.collectionVariables.set('game_session_id', String(payload.data.session.id)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Telegram-Init-Data",
                "value": "{{init_data}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sneakerNumber\": {{sneaker_number}}\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/game/found-sneaker",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "game",
                "found-sneaker"
              ]
            },
            "description": "Отмечает найденный кроссовок. Если это 10-й кроссовок, сервер сам завершает сессию и возвращает finished-состояние."
          },
          "response": []
        },
        {
          "name": "POST /api/game/finish",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const payload = pm.response.json();",
                  "if (payload?.data?.reason !== undefined) { pm.collectionVariables.set('game_reason', String(payload.data.reason)); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Telegram-Init-Data",
                "value": "{{init_data}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/game/finish",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "game",
                "finish"
              ]
            },
            "description": "Сигнал от фронта, что клиентский timer закончился. Если 10 кроссовок еще не собрано, сервер оставляет сессию active, но принудительно ставит remainingSeconds=0 и completionReason=time-ended."
          },
          "response": []
        }
      ]
    }
  ]
}
